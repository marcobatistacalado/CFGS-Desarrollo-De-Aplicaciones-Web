@model Ejemplo_Validaciones_2.Models.Data
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Tus datos</h1>

</div>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form  asp-action="Index">
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input type="text" asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Edad" class="form-label"></label>
        <input type="text" asp-for="Edad" class="form-control" />
        <span asp-validation-for="Edad" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-dark">Enviar</button>
</form>

