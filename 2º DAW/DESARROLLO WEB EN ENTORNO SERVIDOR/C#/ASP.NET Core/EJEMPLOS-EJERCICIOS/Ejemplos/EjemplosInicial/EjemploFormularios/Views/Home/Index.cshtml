@{
    ViewData["Title"] = "Home Page";
}

<h1>Contáctanos</h1><br />
<form asp-controller="Home" asp-action="Contact"> <!--IMPORTANTE PONER ESTOS ATRIBUTOS-->
    <div class="md-3">
        <label for="Nombre" class="form-label">Nombre</label>
        <input type="text" name="Nombre" class="form-control" placeholder="Introduce nombre y apellidos:" />
    </div>

    <div class="md-3">
        <label for="Email" class="form-label">Email</label>
        <input type="text" name="Email" class="form-control" placeholder="ejemplo@gmail.com" />
    </div>

    <div class="md-3">
        <label for="Mensaje" class="form-label">Mensaje</label>
        <textarea name="Mensaje" class="form-control"></textarea>
    </div>
    <br />
    <button type="submit" class="btn-dark">Enviar</button>
</form>
