

@{
    ViewData["Title"] = "Registro";
}


  <div class="flotar">  Registro - Socio</div>
<div class="flotar" id="flotacentro">@ViewData["mensaje"]</div>
  <div class="flotar" id="flotaderecha"> <a >Back to HOME  </a></div>
   

<hr />


    <div class="row ">
    <div class="col-md-7 col-lg-5 col-xl-5 offset-xl-1">
        <form >
            
            <div data-mdb-input-init class="form-outline mb-4">
                <input  placeholder="Nombre"/>
                
            </div>
            <div data-mdb-input-init class="form-outline mb-4">
               
                <input  placeholder="DNI" />
                
            </div>
            <div data-mdb-input-init class="form-outline mb-4">
               
                <input type="password" asp-for="Clave" placeholder="Clave"  />
                
            </div>
            <div data-mdb-input-init class="form-outline mb-4">
               
                <input  placeholder="Teléfono" />
                
            </div>
            
            <div data-mdb-input-init class="form-outline mb-4">
               
                <input asp-for="Matricula" placeholder="Matrícula" />
                
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>




@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
