@model Usuario; //ES OBLIGATORIO METER EL MODELO PARA PODER USAR LOS asp-for
@{
    ViewData["Title"] = "Iniciar Sesión";
}
<h2>Iniciar Sesión</h2>

@if (!string.IsNullOrEmpty(ViewBag.Error as string))
{
    <p style="color: red;">@ViewBag.Error</p>
}

<form asp-controller="Usuarios" asp-action="Login" method="post">
    <div>
        <label for="nick">Usuario:</label>
        <input asp-for="Nick" id="nick" required /> <!--PUEDO USAR name en vez de asp-for...-->
    </div>
    <div>
        <label for="contrasenna">Contraseña:</label>
        <input asp-for="Contrasenna" type="password" id="contrasenna" required />
    </div>
    <button type="submit">Iniciar Sesión</button>
</form>

<p>¿No tienes cuenta? <a asp-controller="Usuarios" asp-action="Registro">Regístrate aquí</a></p>
