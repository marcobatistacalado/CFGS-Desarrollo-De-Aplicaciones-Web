@model CicloDetailView
<table>
    <tr>
        <td>@Model.ciclo.Num_Curso</td>
        <td>@Model.ciclo.Nombre</td>
    </tr>
@foreach (var item in Model.l_alumnos)
{
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.DNI)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CicloAlumno)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CursoAlumno)
        </td>

    </tr>
}
</table>