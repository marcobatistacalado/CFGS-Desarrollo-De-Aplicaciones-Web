@model IEnumerable<ej1.Models.Alumno>

@{
    ViewData["Title"] = "Index";
}

<h1>LISTA DE ALUMNOS</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdAlumno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CicloAlumno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CursoAlumno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellidos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.edad)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IdAlumno)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CicloAlumno)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CursoAlumno)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Apellidos)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefono)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.edad)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.DNI">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.DNI">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.DNI">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
