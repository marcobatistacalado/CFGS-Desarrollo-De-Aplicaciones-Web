@model IEnumerable<Practica6.Models.Category>

@{
    ViewData["Title"] = "Index";
}

<h1>Categorías</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Code)
            </td>
            <td>
                    <a asp-action="Details" asp-route-id="@item.IdCategory">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>
