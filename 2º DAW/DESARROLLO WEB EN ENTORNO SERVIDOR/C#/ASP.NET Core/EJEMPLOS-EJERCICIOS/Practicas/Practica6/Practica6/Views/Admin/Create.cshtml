@model Practica6.Models.JobOffer

@{
    ViewData["Title"] = "Crear Oferta";
}

<h2>Crear Nueva Oferta</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Company"></label>
        <input asp-for="Company" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" required></textarea>
    </div>

    <!-- ⚠️ Este campo se mantiene como readonly -->
    <div class="form-group">
        <label asp-for="CategoryId">Categoría</label>
        <input asp-for="CategoryId" class="form-control" readonly />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Details" asp-route-id="@Model.CategoryId" class="btn btn-secondary">Cancelar</a>
</form>
