@model IEnumerable<Practica6.Models.JobOffer>

@{
    ViewData["Title"] = "Details";
}

<h1>Ofertas</h1>

<p>
    <a asp-action="Create" asp-route-categoryId="@ViewData["CategoryId"]" class="btn btn-success">Crear Nueva Oferta</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Company)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryId)
            </td>
            <td>
                <a asp-action="VerAlumnos" asp-route-id="@item.IdJobOffer">VerAlumnos</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdJobOffer">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
