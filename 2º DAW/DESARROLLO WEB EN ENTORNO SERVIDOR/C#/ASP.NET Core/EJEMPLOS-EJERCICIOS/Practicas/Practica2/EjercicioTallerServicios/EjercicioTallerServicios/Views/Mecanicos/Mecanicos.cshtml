@model List<EjercicioTallerServicios.Models.Mecanico>

@{
    ViewData["Title"] = "Mecánicos";
}

<div class="container mt-4">
    <h1 class="text-center mb-4">Lista de Mecánicos</h1>

    <!-- Tabla de Mecánicos -->
    @if (Model.Any())
    {
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Foto</th>
                    <th>Fecha de Alta</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mecanico in Model)
                {
                    <tr>
                        <td>@mecanico.nombre @mecanico.apellidos</td>
                        <td>@mecanico.telefono</td>
                        <td>
                            <img src="/fotosMecanicos/@mecanico.foto" alt="Foto de @mecanico.nombre" class="img-fluid" style="max-height: 60px; object-fit: cover;" />
                        </td>
                        <td>@mecanico.fAlta.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hay mecánicos disponibles.</p>
    }
</div>
