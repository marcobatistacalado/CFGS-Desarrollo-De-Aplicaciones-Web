@model List<EjercicioTallerServicios.Models.Coche>

@{
    ViewData["Title"] = "Coches";
}

<div class="container mt-4">
    <h1 class="text-center mb-4">Lista de Coches</h1>

    <!-- Tabla de Coches -->
    @if (Model.Any())
    {
        <table class="table table-striped table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Modelo</th>
                    <th>Marca</th>
                    <th>Matrícula</th>
                    <th>Año</th>
                    <th>Dueño</th>
                    <th>Mecánico Asignado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coche in Model)
                {
                    <tr>
                        <td>@coche.modelo</td>
                        <td>@coche.marca</td>
                        <td>@coche.matricula</td>
                        <td>@coche.ano</td>
                        <td>@coche.dueño.nombre @coche.dueño.apellidos</td>
                        <td>@coche.m.nombre @coche.m.apellidos</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hay coches disponibles en el taller.</p>
    }
</div>
